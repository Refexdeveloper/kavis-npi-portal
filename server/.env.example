# =============================================================================
# Kavis Pharma NPI Portal — server environment
# Copy this file to server/.env and fill in local values.
# Never commit server/.env
# =============================================================================

PORT=4300
HOST=0.0.0.0
NODE_ENV=development

# Production: Express serves the built SPA from ../client/out on the same PORT
# Build first:  cd ../client && npm ci && npm run build
SERVE_CLIENT=true

CLIENT_ORIGIN=http://localhost:4300,http://localhost:5173
FORCE_HTTPS=false

# Use a long random string in any shared or production environment
JWT_SECRET=change_this_to_a_secure_random_string

# SQLite file lives here by default: server/data/kavis_npi.sqlite
# Override only if you want the database file somewhere else.
# DB_FILE=/absolute/path/to/kavis_npi.sqlite
