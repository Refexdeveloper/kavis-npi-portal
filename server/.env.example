# =============================================================================
# Kavis Pharma NPI Portal — server environment
# Copy to server/.env for local use. Never commit real secrets.
# Full GCP credential list: see ../GCP_HOSTING.md
# =============================================================================

PORT=4300
HOST=0.0.0.0
NODE_ENV=development

CLIENT_ORIGIN=http://localhost:4300,http://localhost:5173,http://localhost:5174
FORCE_HTTPS=false

JWT_SECRET=change_this_to_a_secure_random_string

# --- MySQL (local) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kavis_npi
DB_POOL_SIZE=10

# --- Cloud SQL on Cloud Run (use instead of DB_HOST when deploying) ---
# INSTANCE_CONNECTION_NAME=PROJECT_ID:REGION:INSTANCE_NAME
# DB_SOCKET_PATH=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# --- Documents: local disk (dev) or GCS (prod) ---
STORAGE_BACKEND=local
# UPLOAD_DIR=   # optional override; default server/uploads
# STORAGE_BACKEND=gcs
# GCS_BUCKET=kavis-npi-docs-yourorg
# GCS_PREFIX=npi-docs/
